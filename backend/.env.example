# Copy to .env and fill in real values. Never commit the real .env.
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"
JWT_SECRET="replace-with-a-long-random-value-generated-via-openssl-rand-base64-48"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Stripe — from https://dashboard.stripe.com/test/apikeys and the webhook config page
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# BTCPay Server — self-hosted instance. Create an API key with invoice-create
# permission for the store, and a webhook (Store Settings > Webhooks) pointed at
# {API_BASE}/webhooks/btcpay with "Invoice settled" + "Invoice expired/invalid" events.
BTCPAY_URL="https://your-btcpay-instance.example.com"
BTCPAY_API_KEY="..."
BTCPAY_STORE_ID="..."
BTCPAY_WEBHOOK_SECRET="..."
