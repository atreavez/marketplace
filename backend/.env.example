# Copy to .env and fill in real values. Never commit the real .env.
# Every var below is validated at boot by src/config/env.validation.ts — the
# app refuses to start with a clear error if something required is missing
# or malformed, rather than failing confusingly on the first request that
# touches the missing piece.
NODE_ENV=development
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"
JWT_SECRET="replace-with-a-long-random-value-generated-via-openssl-rand-base64-48"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Redis — used for distributed rate limiting (see ThrottlerModule in
# app.module.ts) and available for caching/sessions in future modules.
REDIS_URL="redis://localhost:6379"

# Structured logging (Pino). One of: debug, info, warn, error.
LOG_LEVEL=info

# Global rate limit window/count — see src/config/configuration.ts. Per-route
# limits (e.g. auth endpoints) are stricter and set directly in their controllers.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Stripe — from https://dashboard.stripe.com/test/apikeys and the webhook config page
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# BTCPay Server — self-hosted instance. Create an API key with invoice-create
# permission for the store, and a webhook (Store Settings > Webhooks) pointed at
# {API_BASE}/webhooks/btcpay with "Invoice settled" + "Invoice expired/invalid" events.
BTCPAY_URL="https://your-btcpay-instance.example.com"
BTCPAY_API_KEY="..."
BTCPAY_STORE_ID="..."
BTCPAY_WEBHOOK_SECRET="..."
