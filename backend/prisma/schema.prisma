// Prisma schema — Slice 1 (Auth, Listings, Search, Deal Inquiry)
// + Slice 2 (Payments: Stripe + BTCPay Server, escrow-lite via delayed payout)
// Chat, AI, and notifications are still designed-but-not-implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
}

enum DealStage {
  INQUIRY
  NEGOTIATION
  ACCEPTED
  AWAITING_PAYMENT
  PAID
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  BTCPAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  role              UserRole  @default(BUYER)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  // --- Module 2: Identity & Authentication additions ---
  // All new columns are optional/defaulted, so existing rows and every
  // pre-existing query against User remain valid with no backfill required.
  emailVerifiedAt   DateTime?
  avatarUrl         String?
  passwordChangedAt DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // base32 TOTP secret; set once during setup, confirmed on enable

  listings          Listing[]
  buyerDeals        Deal[]    @relation("BuyerDeals")
  sellerDeals       Deal[]    @relation("SellerDeals")

  sessions             Session[]
  loginHistory         LoginHistoryEntry[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  twoFactorBackupCodes TwoFactorBackupCode[]

  @@map("users")
}

// One row per logged-in device/browser. Owns the current refresh token for
// that device (rotated on every /auth/refresh call) — this is what powers
// device management, "log out this device", "log out everywhere", and lets
// an access token be invalidated immediately on logout instead of waiting
// out its 15-minute lifetime (see JwtStrategy's session check).
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  refreshTokenHash  String    @unique // sha256 of the current valid opaque refresh token
  previousTokenHash String?   // last rotated-away hash, kept briefly to detect reuse (token-theft signal)
  deviceLabel       String?   // client-supplied ("Chrome on macOS"), best-effort
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId])
  @@map("sessions")
}

// Append-only — every login attempt, successful or not, for security
// visibility ("has anyone tried to get into my account") and the Login
// History feature. Never updated after insert.
model LoginHistoryEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  success   Boolean
  reason    String? // e.g. "invalid_password", "2fa_failed", "success"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Single-use recovery codes issued when 2FA is enabled, for when the user
// loses their authenticator device. Each code hashed at rest, like a password.
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  attributeSchema Json       @default("{}")
  listings        Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  title       String
  description String
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("USD")
  customAttrs Json          @default("{}")
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  deals       Deal[]

  @@index([status])
  @@index([categoryId])
  @@map("listings")
}

model Deal {
  id         String      @id @default(uuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id])
  buyerId    String
  buyer      User        @relation("BuyerDeals", fields: [buyerId], references: [id])
  sellerId   String
  seller     User        @relation("SellerDeals", fields: [sellerId], references: [id])
  stage      DealStage   @default(INQUIRY)
  message    String?
  createdAt  DateTime    @default(now())

  events     DealEvent[]
  payment    Payment?

  @@map("deals")
}

// One payment attempt per deal in this slice (a failed attempt can be retried by
// creating a fresh Payment row rather than mutating a failed one — keeps the
// financial record append-only in spirit even though the model isn't itself an event log).
model Payment {
  id            String          @id @default(uuid())
  dealId        String          @unique
  deal          Deal            @relation(fields: [dealId], references: [id])
  provider      PaymentProvider
  providerRef   String          @unique // Stripe PaymentIntent id, or BTCPay invoice id
  amount        Decimal         @db.Decimal(12, 2)
  currency      String
  status        PaymentStatus   @default(PENDING)
  cryptoTxHash  String?
  confirmations Int?
  raw           Json?           // last raw webhook payload, for audit/debugging
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([provider, providerRef])
  @@map("payments")
}

// Immutable audit trail — rows are only ever inserted, never updated/deleted.
model DealEvent {
  id        String    @id @default(uuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  fromStage DealStage?
  toStage   DealStage
  actorId   String
  createdAt DateTime  @default(now())

  @@map("deal_events")
}
