// Prisma schema — Slice 1 (Auth, Listings, Search, Deal Inquiry)
// + Slice 2 (Payments: Stripe + BTCPay Server, escrow-lite via delayed payout)
// Chat, AI, and notifications are still designed-but-not-implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
}

enum DealStage {
  INQUIRY
  NEGOTIATION
  ACCEPTED
  AWAITING_PAYMENT
  PAID
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  BTCPAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

// --- Module 3: User Profiles ---
enum VerificationRequestType {
  IDENTITY
  SELLER
  BUSINESS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SocialPlatform {
  WEBSITE
  INSTAGRAM
  TWITTER
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  OTHER
}

enum BusinessType {
  INDIVIDUAL
  COMPANY
  NONPROFIT
  OTHER
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  role              UserRole  @default(BUYER)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  // --- Module 2: Identity & Authentication additions ---
  // All new columns are optional/defaulted, so existing rows and every
  // pre-existing query against User remain valid with no backfill required.
  emailVerifiedAt   DateTime?
  avatarUrl         String?
  passwordChangedAt DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // base32 TOTP secret; set once during setup, confirmed on enable

  listings          Listing[]
  buyerDeals        Deal[]    @relation("BuyerDeals")
  sellerDeals       Deal[]    @relation("SellerDeals")

  sessions             Session[]
  loginHistory         LoginHistoryEntry[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  twoFactorBackupCodes TwoFactorBackupCode[]

  // --- Module 3: User Profiles additions ---
  buyerProfile         BuyerProfile?
  sellerProfile        SellerProfile?
  verificationRequests VerificationRequest[]
  socialLinks          SocialLink[]
  addresses            Address[]
  savedLocations       SavedLocation[]
  preferences          UserPreferences?
  privacySettings      PrivacySettings?
  notificationSettings NotificationSettings?

  @@map("users")
}

// One row per logged-in device/browser. Owns the current refresh token for
// that device (rotated on every /auth/refresh call) — this is what powers
// device management, "log out this device", "log out everywhere", and lets
// an access token be invalidated immediately on logout instead of waiting
// out its 15-minute lifetime (see JwtStrategy's session check).
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  refreshTokenHash  String    @unique // sha256 of the current valid opaque refresh token
  previousTokenHash String?   // last rotated-away hash, kept briefly to detect reuse (token-theft signal)
  deviceLabel       String?   // client-supplied ("Chrome on macOS"), best-effort
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId])
  @@map("sessions")
}

// Append-only — every login attempt, successful or not, for security
// visibility ("has anyone tried to get into my account") and the Login
// History feature. Never updated after insert.
model LoginHistoryEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  success   Boolean
  reason    String? // e.g. "invalid_password", "2fa_failed", "success"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Single-use recovery codes issued when 2FA is enabled, for when the user
// loses their authenticator device. Each code hashed at rest, like a password.
model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  attributeSchema Json       @default("{}")
  listings        Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  title       String
  description String
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("USD")
  customAttrs Json          @default("{}")
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  deals       Deal[]

  @@index([status])
  @@index([categoryId])
  @@map("listings")
}

model Deal {
  id         String      @id @default(uuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id])
  buyerId    String
  buyer      User        @relation("BuyerDeals", fields: [buyerId], references: [id])
  sellerId   String
  seller     User        @relation("SellerDeals", fields: [sellerId], references: [id])
  stage      DealStage   @default(INQUIRY)
  message    String?
  createdAt  DateTime    @default(now())

  events     DealEvent[]
  payment    Payment?

  @@map("deals")
}

// One payment attempt per deal in this slice (a failed attempt can be retried by
// creating a fresh Payment row rather than mutating a failed one — keeps the
// financial record append-only in spirit even though the model isn't itself an event log).
model Payment {
  id            String          @id @default(uuid())
  dealId        String          @unique
  deal          Deal            @relation(fields: [dealId], references: [id])
  provider      PaymentProvider
  providerRef   String          @unique // Stripe PaymentIntent id, or BTCPay invoice id
  amount        Decimal         @db.Decimal(12, 2)
  currency      String
  status        PaymentStatus   @default(PENDING)
  cryptoTxHash  String?
  confirmations Int?
  raw           Json?           // last raw webhook payload, for audit/debugging
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([provider, providerRef])
  @@map("payments")
}

// Immutable audit trail — rows are only ever inserted, never updated/deleted.
model DealEvent {
  id        String    @id @default(uuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  fromStage DealStage?
  toStage   DealStage
  actorId   String
  createdAt DateTime  @default(now())

  @@map("deal_events")
}

// ==========================================================================
// Module 3: User Profiles
// ==========================================================================

// Buyer-specific profile data — separate from the base User record so the
// "buyer profile" concept can grow (favorite categories, buying preferences)
// without bloating User itself. Optional/lazy: created on first access.
model BuyerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  bio               String?
  favoriteCategories String[] @default([])
  defaultAddressId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("buyer_profiles")
}

// Created when a user starts selling. A user can hold both a BuyerProfile
// and a SellerProfile at once (role BOTH) — the two are independent, not
// mutually exclusive, matching how the platform's User.role already works.
model SellerProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])
  storeName          String?
  bio                String?
  responseTimeHours  Int?
  ratingAvg          Decimal             @default(0) @db.Decimal(3, 2)
  ratingCount        Int                 @default(0)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  businessProfile    BusinessProfile?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("seller_profiles")
}

// Optional — only present for sellers who register as a business rather
// than an individual. Kept separate from SellerProfile so "am I a business"
// is a clean presence check, not an extra flag to keep in sync.
model BusinessProfile {
  id                 String              @id @default(uuid())
  sellerProfileId    String              @unique
  sellerProfile      SellerProfile       @relation(fields: [sellerProfileId], references: [id])
  legalName          String
  businessType       BusinessType        @default(INDIVIDUAL)
  registrationNumber String?
  taxId              String?
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("business_profiles")
}

// A trackable verification process (not just a flag) — every request a user
// makes to get identity/seller/business status verified, reviewed
// out-of-band by an admin (admin review tooling is a future module; this is
// the data model it will operate on). Denormalized status also lives on
// SellerProfile/BusinessProfile for fast reads without joining here.
model VerificationRequest {
  id         String                  @id @default(uuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id])
  type       VerificationRequestType
  status     VerificationStatus      @default(PENDING)
  notes      String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime                @default(now())

  @@index([userId, type])
  @@map("verification_requests")
}

model SocialLink {
  id       String         @id @default(uuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id])
  platform SocialPlatform
  url      String
  isPublic Boolean        @default(true)

  @@index([userId])
  @@map("social_links")
}

// Shipping/billing address book — distinct from SavedLocation below, which
// is a map bookmark rather than a postal address.
model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  label         String? // "Home", "Work", etc.
  recipientName String?
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?
  country       String // ISO 3166-1 alpha-2
  phone         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// A bookmarked map point (e.g. "near my usual pickup spot") — lighter
// weight than a full postal Address, used for location-aware search/
// nearby-services features rather than shipping.
model SavedLocation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  latitude  Float
  longitude Float
  address   String? // freeform, human-readable — not validated like Address
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_locations")
}

// Language/currency/theme/timezone — one row per user, lazily created with
// defaults on first read so there's no separate "initialize my settings" step.
model UserPreferences {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id])
  language  String          @default("en") // ISO 639-1
  currency  String          @default("USD") // ISO 4217
  theme     ThemePreference @default(SYSTEM)
  timezone  String          @default("UTC") // IANA timezone name
  updatedAt DateTime        @updatedAt

  @@map("user_preferences")
}

model PrivacySettings {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  user                     User              @relation(fields: [userId], references: [id])
  profileVisibility        ProfileVisibility @default(PUBLIC)
  showEmailPublicly        Boolean           @default(false)
  showPhonePublicly        Boolean           @default(false)
  allowMessagesFromStrangers Boolean         @default(true)
  searchEngineIndexing     Boolean           @default(true)
  updatedAt                DateTime          @updatedAt

  @@map("privacy_settings")
}

model NotificationSettings {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  emailEnabled     Boolean  @default(true)
  pushEnabled      Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  // Granular topic toggles — only meaningful when their parent channel
  // above is also enabled; enforced in the service layer, not the schema.
  dealUpdates      Boolean  @default(true)
  priceDrops       Boolean  @default(true)
  newMessages      Boolean  @default(true)
  marketing        Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("notification_settings")
}
