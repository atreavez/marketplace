// Prisma schema — Slice 1 (Auth, Listings, Search, Deal Inquiry)
// + Slice 2 (Payments: Stripe + BTCPay Server, escrow-lite via delayed payout)
// Chat, AI, and notifications are still designed-but-not-implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
}

enum DealStage {
  INQUIRY
  NEGOTIATION
  ACCEPTED
  AWAITING_PAYMENT
  PAID
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  BTCPAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         UserRole  @default(BUYER)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  listings     Listing[]
  buyerDeals   Deal[]    @relation("BuyerDeals")
  sellerDeals  Deal[]    @relation("SellerDeals")

  @@map("users")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  attributeSchema Json       @default("{}")
  listings        Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  title       String
  description String
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("USD")
  customAttrs Json          @default("{}")
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  deals       Deal[]

  @@index([status])
  @@index([categoryId])
  @@map("listings")
}

model Deal {
  id         String      @id @default(uuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id])
  buyerId    String
  buyer      User        @relation("BuyerDeals", fields: [buyerId], references: [id])
  sellerId   String
  seller     User        @relation("SellerDeals", fields: [sellerId], references: [id])
  stage      DealStage   @default(INQUIRY)
  message    String?
  createdAt  DateTime    @default(now())

  events     DealEvent[]
  payment    Payment?

  @@map("deals")
}

// One payment attempt per deal in this slice (a failed attempt can be retried by
// creating a fresh Payment row rather than mutating a failed one — keeps the
// financial record append-only in spirit even though the model isn't itself an event log).
model Payment {
  id            String          @id @default(uuid())
  dealId        String          @unique
  deal          Deal            @relation(fields: [dealId], references: [id])
  provider      PaymentProvider
  providerRef   String          @unique // Stripe PaymentIntent id, or BTCPay invoice id
  amount        Decimal         @db.Decimal(12, 2)
  currency      String
  status        PaymentStatus   @default(PENDING)
  cryptoTxHash  String?
  confirmations Int?
  raw           Json?           // last raw webhook payload, for audit/debugging
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([provider, providerRef])
  @@map("payments")
}

// Immutable audit trail — rows are only ever inserted, never updated/deleted.
model DealEvent {
  id        String    @id @default(uuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  fromStage DealStage?
  toStage   DealStage
  actorId   String
  createdAt DateTime  @default(now())

  @@map("deal_events")
}
